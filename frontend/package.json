{
  "name": "@api-explorer/react",
  "version": "0.7.0",
  "type": "module",
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./style.css": "./dist/api-explorer.css",
    "./licenses/JetBrainsMono-OFL.txt": "./dist/JetBrainsMono-OFL.txt",
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./ui/styles/*.css": "./dist/ui/styles/*.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "vite build && vite build --mode core && tsc -p tsconfig.build.json && node build-ui.mjs && npm run check && vite build --config vite.standalone.config.ts",
    "test": "node --test test/*.test.mjs",
    "dev": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/node": "24.13.3",
    "rolldown": "1.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PerfectZQ/openapi-workbench.git",
    "directory": "frontend"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react-i18next": "^17.0.15",
    "i18next": "^26.4.2",
    "monaco-editor": "0.56.0",
    "motion": "^13.2.0"
  }
}
