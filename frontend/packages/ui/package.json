{
  "name": "@workbench/ui",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./code-editor/monaco": {
      "types": "./dist/code-editor/monaco.d.ts",
      "default": "./dist/code-editor/monaco.js"
    },
    "./styles/*.css": "./dist/styles/*.css"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "monaco-editor": "0.56.0",
    "motion": "^13.2.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PerfectZQ/openapi-workbench.git",
    "directory": "frontend/packages/ui"
  }
}
