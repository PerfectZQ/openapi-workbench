package sdk

import (
	"bytes"
	"context"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"mime"
	"strings"
)

type restParameter struct{ name, in string }

type restRoute struct {
	method, path string
	parameters   []restParameter
	file         bool
}

type actionRoute struct {
	path, name, version   string
	inputJSON, outputJSON []string
}

type operationRoutes struct {
	rest   restRoute
	action actionRoute
}

// call maps one typed input and result to the selected protocol.
func (c *Client) call(ctx context.Context, routes operationRoutes, input, output any) error {
	data, err := json.Marshal(input)
	if err != nil {
		return err
	}
	request := map[string]any{}
	if err := decodeJSON(data, &request); err != nil {
		return err
	}
	var params []parameter
	var body any = request
	action := c.config.Protocol == "action" || c.config.InnerTOPVersion != ""
	var wire operation
	if action {
		if routes.action.name == "" {
			return fmt.Errorf("sdk: operation does not expose Action")
		}
		if routes.action.path == "" && c.config.InnerTOPVersion == "" {
			return fmt.Errorf("sdk: direct Action requests require a route path")
		}
		for _, path := range routes.action.inputJSON {
			if err := projectJSON(request, strings.Split(path, "."), true); err != nil {
				return err
			}
		}
		wire = operation{method: "POST", path: routes.action.path, action: routes.action.name, innerTOP: true}
		version := routes.action.version
		if pinned := c.config.InnerTOPVersion; pinned != "" && pinned != version {
			return fmt.Errorf("sdk: %s requires InnerTOP version %s (configured %s)", routes.action.name, version, pinned)
		}
		params = append(params, parameter{"Version", "query", version, true})
		body = map[string]any{"Request": request}
	} else {
		if routes.rest.path == "" {
			return fmt.Errorf("sdk: operation does not expose REST")
		}
		wire = operation{method: routes.rest.method, path: routes.rest.path}
		for _, binding := range routes.rest.parameters {
			value, exists := request[binding.name]
			if exists && value != nil {
				text := fmt.Sprint(value)
				if array, ok := value.([]any); ok {
					encoded, err := json.Marshal(array)
					if err != nil {
						return err
					}
					text = string(encoded)
				}
				params = append(params, parameter{binding.name, binding.in, text, binding.in == "path"})
			}
			delete(request, binding.name)
		}
		if len(request) == 0 || wire.method == "GET" {
			body = nil
		}
	}
	if !action && routes.rest.file {
		response, err := c.request(ctx, wire, params, body, nil)
		if err != nil {
			return err
		}
		defer response.Body.Close()
		content, err := io.ReadAll(io.LimitReader(response.Body, 32<<20+1))
		if err != nil {
			return err
		}
		if len(content) > 32<<20 {
			return fmt.Errorf("sdk: response exceeds 32 MiB")
		}
		_, disposition, _ := mime.ParseMediaType(response.Header.Get("Content-Disposition"))
		data, err := json.Marshal(map[string]any{"name": disposition["filename"], "content_type": response.Header.Get("Content-Type"), "content": base64.StdEncoding.EncodeToString(content)})
		if err != nil {
			return err
		}
		return decodeJSON(data, output)
	}
	var response json.RawMessage
	if _, err := c.request(ctx, wire, params, body, &response); err != nil {
		return err
	}
	var envelope struct {
		Data   json.RawMessage `json:"data"`
		Result json.RawMessage `json:"Result"`
	}
	if err := decodeJSON(response, &envelope); err != nil {
		return err
	}
	result := envelope.Data
	if action {
		result = envelope.Result
		if len(routes.action.outputJSON) > 0 {
			var object any
			if err := decodeJSON(result, &object); err != nil {
				return err
			}
			for _, path := range routes.action.outputJSON {
				if err := projectJSON(object, strings.Split(path, "."), false); err != nil {
					return err
				}
			}
			var err error
			result, err = json.Marshal(object)
			if err != nil {
				return err
			}
		}
	}
	return decodeJSON(result, output)
}

func decodeJSON(data []byte, target any) error {
	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.UseNumber()
	return decoder.Decode(target)
}

func projectJSON(value any, path []string, encode bool) error {
	if value == nil || len(path) == 0 {
		return nil
	}
	if path[0] == "*" {
		items, ok := value.([]any)
		if !ok {
			return fmt.Errorf("sdk: JSON projection expects an array")
		}
		for _, item := range items {
			if err := projectJSON(item, path[1:], encode); err != nil {
				return err
			}
		}
		return nil
	}
	object, ok := value.(map[string]any)
	if !ok {
		return fmt.Errorf("sdk: JSON projection expects an object")
	}
	child, exists := object[path[0]]
	if !exists {
		return nil
	}
	if len(path) > 1 {
		return projectJSON(child, path[1:], encode)
	}
	if encode {
		data, err := json.Marshal(child)
		if err != nil {
			return err
		}
		object[path[0]] = string(data)
		return nil
	}
	text, ok := child.(string)
	if !ok {
		return fmt.Errorf("sdk: Action result field %s is not a JSON string", path[0])
	}
	var decoded any
	if err := decodeJSON([]byte(text), &decoded); err != nil {
		return err
	}
	object[path[0]] = decoded
	return nil
}
