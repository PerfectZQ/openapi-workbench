package main

import (
 "context"
 _ "embed"
 "os"
 "os/signal"

 "github.com/PerfectZQ/openapi-workbench/cli"
)

//go:embed swagger.json
var specification []byte

func main() {
 ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt)
 defer cancel()
 app := cli.App{Name: {{printf "%q" .Name}}, EnvPrefix: {{printf "%q" .EnvPrefix}}, Specification: specification}
 os.Exit(app.Run(ctx, os.Args[1:], os.Stdin, os.Stdout))
}
